datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
  EPIC
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum FocusSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum XPTransactionType {
  TASK_COMPLETION
  TASK_REVERSAL
  FOCUS_SESSION
  STREAK_BONUS
  ACHIEVEMENT
  MANUAL_ADJUSTMENT
}

model User {
  id                  String            @id @default(uuid())
  email               String            @unique
  name                String?
  displayName         String?
  avatarUrl           String?
  timezone            String            @default("UTC")
  onboardingCompleted Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  categories          TaskCategory[]
  dailyPlans          DailyPlan[]
  tasks               Task[]
  recurringTasks      RecurringTask[]
  progress            UserProgress?
  xpTransactions      XPTransaction[]
  focusSessions       FocusSession[]
  achievements        UserAchievement[]
}

model TaskCategory {
  id             String          @id @default(uuid())
  userId         String
  name           String
  colour         String?
  icon           String?
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
  recurringTasks RecurringTask[]

  @@unique([userId, name])
  @@index([userId, position])
}

model DailyPlan {
  id          String    @id @default(uuid())
  userId      String
  date        DateTime  @db.Date
  dailyGoal   String?
  notes       String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([userId, date])
  @@index([userId, isCompleted, date])
}

model Task {
  id               String          @id @default(uuid())
  userId           String
  dailyPlanId      String?
  categoryId       String?
  recurringTaskId  String?
  title            String
  description      String?
  status           TaskStatus      @default(PLANNED)
  priority         TaskPriority    @default(MEDIUM)
  difficulty       TaskDifficulty  @default(MEDIUM)
  scheduledDate    DateTime        @db.Date
  startTime        Int?
  endTime          Int?
  estimatedMinutes Int?
  actualMinutes    Int?
  position         Int             @default(0)
  xpReward         Int
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlan        DailyPlan?      @relation(fields: [dailyPlanId], references: [id], onDelete: SetNull)
  category         TaskCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTask    RecurringTask?  @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)
  focusSessions    FocusSession[]
  xpTransactions   XPTransaction[]

  @@index([userId, scheduledDate])
  @@index([userId, status])
  @@index([dailyPlanId, position])
  @@index([recurringTaskId])
  @@index([categoryId])
}

model RecurringTask {
  id                String              @id @default(uuid())
  userId            String
  categoryId        String?
  title             String
  description       String?
  priority          TaskPriority        @default(MEDIUM)
  difficulty        TaskDifficulty      @default(MEDIUM)
  startTime         Int?
  endTime           Int?
  estimatedMinutes  Int?
  xpReward          Int
  frequency         RecurrenceFrequency
  interval          Int                 @default(1)
  daysOfWeek        Int[]               @default([])
  dayOfMonth        Int?
  startsOn          DateTime            @db.Date
  endsOn            DateTime?           @db.Date
  isActive          Boolean             @default(true)
  lastGeneratedDate DateTime?           @db.Date
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          TaskCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks             Task[]

  @@index([userId, isActive])
  @@index([categoryId])
}

model UserProgress {
  id                String    @id @default(uuid())
  userId            String    @unique
  totalXp           Int       @default(0)
  currentLevel      Int       @default(1)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastCompletedDate DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XPTransaction {
  id             String            @id @default(uuid())
  userId         String
  taskId         String?
  focusSessionId String?
  achievementId  String?
  type           XPTransactionType
  amount         Int
  reason         String
  metadata       Json?
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  focusSession   FocusSession?     @relation(fields: [focusSessionId], references: [id], onDelete: SetNull)
  achievement    Achievement?      @relation(fields: [achievementId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type])
  @@index([taskId])
  @@index([focusSessionId])
  @@index([achievementId])
}

model FocusSession {
  id             String             @id @default(uuid())
  userId         String
  taskId         String?
  status         FocusSessionStatus @default(ACTIVE)
  plannedMinutes Int
  actualMinutes  Int?
  startedAt      DateTime           @default(now())
  endedAt        DateTime?
  xpAwarded      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  xpTransactions XPTransaction[]

  @@index([userId, startedAt])
  @@index([taskId, status])
}

model Achievement {
  id             String            @id @default(uuid())
  code           String            @unique
  name           String
  description    String
  icon           String?
  xpReward       Int
  criteria       Json
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  userUnlocks    UserAchievement[]
  xpTransactions XPTransaction[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime?
  progress      Int         @default(0)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@unique([userId, achievementId])
  @@index([achievementId, unlockedAt])
}
